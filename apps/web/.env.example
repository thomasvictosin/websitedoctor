#DATABASE_URL="postgresql://doctor:doctor@localhost:5432/website_doctor?schema=public"
# Optional direct PostgreSQL URL for Prisma CLI schema changes (e.g. Supabase).
# Leave blank for local Docker; DATABASE_URL will be used instead.
DATABASE_URL=""
DIRECT_URL=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
APP_ORIGIN="http://localhost:3000"
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
TRUST_PROXY="false"
# AI: Claude is used when an Anthropic key is set (Settings → Integrations, or here).
# CLAUDE_MODEL: claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-5-5.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL=""
# Without a key, the self-hosted Ollama server below is used.
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Secret for /api/cron/monitor (scheduled availability + security checks on serverless hosts).
# Vercel Cron sends it automatically as a Bearer token; external schedulers must send
# "Authorization: Bearer <CRON_SECRET>". Minimum 16 characters.
CRON_SECRET=""

# Optional: known-vulnerability matching for installed plugins and WordPress core.
# Free API key from a Wordfence account (Wordfence Intelligence → Vulnerability Data Feed).
# Refreshed daily by /api/cron/vulnerabilities.
WORDFENCE_INTELLIGENCE_API_KEY=""
# Optional fallbacks; these keys can also be pasted in Settings → Integrations (stored encrypted).
PAGESPEED_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM=""
